# Copy this file to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string
DATABASE_URL=postgresql://YOUR_USERNAME@localhost/stockflow

# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse the placeholder value below, and never commit a real one.
SECRET_KEY=replace-me-with-a-real-generated-secret
